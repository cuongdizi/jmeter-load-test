  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Kiem thu tai - test.k6.io (QuickPizza)" enabled="true">
      <stringProp name="TestPlan.comments">Bai tap kiem thu phan mem - Kiem thu tai website demo test.k6.io (redirect ve quickpizza.grafana.com) bang Apache JMeter. 50 users, ramp-up 20s, loop 3.</stringProp>
